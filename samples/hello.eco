// EcoLang demonstration program.
// Shows variable declarations, arithmetic, constant folding,
// constant propagation, algebraic simplification, and loops.

// --- Constant folding ---
let sum = 10 + 20
let product = 5 * 4
let precedence = 2 + 3 * 4
let quotient = 100 / 5

// --- Chained expressions (values reused across expressions) ---
let total = sum + product
let average = total / 2

// --- Algebraic simplification ---
let a = total + 0
let b = 0 + total
let c = total - 0
let d = total * 1
let e = 1 * total
let f = total * 0
let g = 0 * total

print sum
print product
print precedence
print quotient
print total
print average
print a
print b
print c
print d
print e
print f
print g

// --- A repeat loop ---
repeat 3
    print "Looping"
    print total
end

// --- Nested repeat loops (2 x 3 = 6 total inner iterations) ---
repeat 2
    repeat 3
        print "Nested"
    end
end
