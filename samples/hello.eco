// A small order calculator for a fruit stand.
// Computes the cost of one order, then processes several similar
// orders, printing a short summary for each.

let applePrice = 30
let orangePrice = 25
let quantity = 4

let appleCost = applePrice * quantity
let orangeCost = orangePrice * quantity
let subtotal = appleCost + orangeCost

let discount = subtotal / 10
let total = subtotal - discount

print "Order summary"
print applePrice
print orangePrice
print appleCost
print orangeCost
print subtotal
print discount
print total

// Delivery fee depends on the distance from the warehouse to the stand.
let baseFee = 2 * (3 + 7)
let deliveryFee = baseFee + 0
let finalTotal = total + deliveryFee

print deliveryFee
print finalTotal

// Process a batch of identical orders and pack each one.
repeat 3
    let batchTotal = finalTotal * 1
    print "Processing batch"
    print batchTotal

    repeat 2
        print "Packing item"
    end
end
